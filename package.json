{
  "name": "koberlet",
  "productName": "Koberlet",
  "version": "1.4.7",
  "description": "Koberlet — monedero de escritorio multi-cadena (Kadena + EVM) de DNNS",
  "main": "main.js",
  "author": "DNNS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@kadena/cryptography-utils": "^0.4.4",
    "@kadena/hd-wallet": "^0.6.2",
    "blakejs": "^1.2.1",
    "ethers": "^6.13.2",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "es.dnns.monedero",
    "productName": "MonederoDNNS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
